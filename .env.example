APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 via XAMPP (development database).
# Automated tests override this with the dedicated database aquasecure_test (see phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquasecure
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Un worker doit tourner pour traiter la file : php artisan queue:work
# (`composer run dev` et scripts\start-projet.bat le lancent automatiquement).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
# In development: MAIL_MAILER=log logs emails to storage/logs/laravel.log
# For production, use SMTP and configure MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aquasecure.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Premier compte administrateur (utilisé uniquement par AdminUserSeeder, jamais commité).
# Si ces variables sont absentes, AdminUserSeeder ne crée aucun compte.
AQUASECURE_ADMIN_NAME="Administrateur"
AQUASECURE_ADMIN_EMAIL=
AQUASECURE_ADMIN_PASSWORD=

# Détection des incidents similaires
INCIDENT_SIMILARITY_WINDOW_DAYS=30
INCIDENT_SIMILARITY_MAX_CANDIDATES=50
INCIDENT_SIMILARITY_MIN_SCORE=60
INCIDENT_SIMILARITY_MAX_SUGGESTIONS=5
INCIDENT_SIMILARITY_RECURRING_THRESHOLD=3

# Confirmation IA optionnelle (Groq, compatible OpenAI ; désactivée par défaut).
# Aucune clé réelle ne doit être commitée.
INCIDENT_SIMILARITY_AI_ENABLED=false
GROQ_API_KEY=gsk_votre_cle_ici
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# openai/gpt-oss-120b est un modèle de raisonnement : prévoir assez de tokens.
# llama-3.3-70b-versatile n'est plus disponible chez Groq (HTTP 404 constaté).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
GROQ_CONNECT_TIMEOUT=5
GROQ_MAX_COMPLETION_TOKENS=1500
# low | medium | high (ignoré pour les modèles sans raisonnement)
GROQ_REASONING_EFFORT=low
# Pause entre deux appels IA consécutifs (millisecondes).
GROQ_DELAY_MS=1000

# IA locale Ollama (rapport global Gestion 1 — voir scripts/start-projet.bat).
# Le rapport PDF se génère même si Ollama est éteint ou absent.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Couche IA locale réutilisable (Gestion 5 et modules futurs) — Ollama uniquement.
# Règle zéro coût : aucun appel externe n'est jamais fait ; le code refuse toute
# URL dont l'hôte n'est pas local (localhost, 127.x.x.x ou ::1). Le module reste
# fonctionnel sans Ollama : LocalLlmService renvoie success=false et l'appelant
# bascule sur son propre traitement de secours.
#
# Installation manuelle (à faire une seule fois sur le poste, jamais par le code) :
#   1. Windows : winget install -e --id Ollama.Ollama   (ou installeur https://ollama.com/download)
#      Linux :  curl -fsSL https://ollama.com/install.sh | sh
#   2. ollama serve                      (démarrer le serveur local, port 11434)
#   3. ollama pull llama3.2              (modèle par défaut, léger, déjà utilisé par Gestion 1)
#      Autre modèle local gratuit au choix : ollama pull qwen2.5:3b
#   4. Vérifier : ollama list
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_TIMEOUT=120
LOCAL_LLM_CONNECT_TIMEOUT=5
LOCAL_LLM_TEMPERATURE=0.3

# Dons citoyens — Stripe Checkout (MODE TEST UNIQUEMENT).
# Récupérer les clés sur https://dashboard.stripe.com/test/apikeys
# Ne jamais utiliser de clé sk_live_ / pk_live_ : le code refuse le mode live.
# STRIPE_WEBHOOK_SECRET est fourni par `stripe listen` (voir docs/stripe-dons.md).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Devise et bornes des dons (EUR uniquement par défaut, voir config/donations.php).
DONATION_CURRENCY=EUR
DONATION_MIN_AMOUNT=1
DONATION_MAX_AMOUNT=5000
