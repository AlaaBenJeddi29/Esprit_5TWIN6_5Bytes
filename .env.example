APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 via XAMPP (development database).
# Automated tests override this with the dedicated database aquasecure_test (see phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquasecure
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Premier compte administrateur (utilisé uniquement par AdminUserSeeder, jamais commité).
# Si ces variables sont absentes, AdminUserSeeder ne crée aucun compte.
AQUASECURE_ADMIN_NAME="Administrateur"
AQUASECURE_ADMIN_EMAIL=
AQUASECURE_ADMIN_PASSWORD=

# Détection des incidents similaires
INCIDENT_SIMILARITY_WINDOW_DAYS=30
INCIDENT_SIMILARITY_MAX_CANDIDATES=50
INCIDENT_SIMILARITY_MIN_SCORE=60
INCIDENT_SIMILARITY_MAX_SUGGESTIONS=5
INCIDENT_SIMILARITY_RECURRING_THRESHOLD=3

# Confirmation IA optionnelle (désactivée par défaut, aucune clé commitée).
# La clé et l'URL doivent appartenir au même fournisseur compatible OpenAI.
# Endpoint xAI documenté : https://api.x.ai/v1/chat/completions
INCIDENT_SIMILARITY_AI_ENABLED=false
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-4.7
XAI_TIMEOUT=15

# IA locale Ollama (rapport global Gestion 1 — voir scripts/start-projet.bat).
# Le rapport PDF se génère même si Ollama est éteint ou absent.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
