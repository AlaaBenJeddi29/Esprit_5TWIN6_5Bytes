<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Clé de test déterministe : jamais utilisée hors des tests. -->
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL 8 (XAMPP) uniquement. This database must be created manually and must never be the development database. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="aquasecure_ci_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Aucun appel IA réel pendant les tests : les clés sont vides/factices
             et les URL pointent vers une machine locale. Les tests qui exercent
             ces intégrations remplacent la configuration et utilisent Http::fake. -->
        <env name="INCIDENT_SIMILARITY_AI_ENABLED" value="false" force="true"/>
        <env name="GROQ_API_KEY" value="test" force="true"/>
        <env name="GROQ_API_URL" value="https://api.groq.com/openai/v1/chat/completions" force="true"/>
        <env name="GROQ_MODEL" value="openai/gpt-oss-120b" force="true"/>
        <env name="GROQ_TIMEOUT" value="30" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GEMINI_TIMEOUT" value="5" force="true"/>
        <env name="OLLAMA_URL" value="http://127.0.0.1:11434" force="true"/>
        <env name="OLLAMA_TIMEOUT" value="5" force="true"/>
        <env name="LOCAL_LLM_ENABLED" value="false" force="true"/>
        <env name="LOCAL_LLM_URL" value="http://127.0.0.1:11434" force="true"/>
        <env name="LOCAL_LLM_TIMEOUT" value="5" force="true"/>
        <env name="LOCAL_LLM_CONNECT_TIMEOUT" value="1" force="true"/>
        <env name="STRIPE_KEY" value="" force="true"/>
        <env name="STRIPE_SECRET" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
    </php>
</phpunit>
